# Copy this file to `.env` for local development:
#
#     cp .env.example .env
#
# The one variable below is PUBLIC. Vite inlines every VITE_-prefixed variable
# into the JavaScript bundle, so it is readable in the shipped site — and that is
# fine, because it is only an endpoint address. The app key, which is the actual
# credential, is never a build-time value: it is typed once per device and lives
# only in that device's localStorage. Never put a real secret in a VITE_
# variable. In CI this comes from an Actions repository variable.

# The Apps Script web app that mints Google access tokens, ending in /exec.
# Deployed from the account that owns the ledger spreadsheet. See SETUP.md.
VITE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbREPLACE-with-your-own-deployment/exec
