# Copy this file to `.env` for local development:
#
#     cp .env.example .env
#
# Both variables below are PUBLIC. Vite inlines every VITE_-prefixed variable
# into the JavaScript bundle, so both are readable in the shipped site. That is
# expected — see the Security model section of README.md. `.env` is gitignored
# only so you are not editing a tracked file. Never put a real secret in a
# VITE_ variable. In CI these come from Actions repository variables.

# OAuth 2.0 Client ID, type "Web application".
# Protected by its "Authorized JavaScript origins" list, which must contain
# http://localhost:5173 and https://huangwaylon.github.io — the same client ID
# used from any other origin is rejected by Google. See SETUP.md step 4.
VITE_GOOGLE_CLIENT_ID=000000000000-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com

# Browser API key, used by the Google Picker.
# Protected by an HTTP-referrer restriction plus an API restriction limiting it
# to the Sheets, Drive, and Picker APIs. See SETUP.md step 5.
VITE_GOOGLE_API_KEY=AIzaSyDUMMY-replace-with-your-own-browser-key
